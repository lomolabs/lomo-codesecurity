# `make init` replaces these placeholders with this checkout's canonical path.
# To scan other repositories, use Projects > Authorize another source root.
# Approve each exact read-only root; never broaden access to a common parent.
KODESEC_REPO_ROOT=__INITIALIZED_BY_MAKE_INIT__
KODESEC_ALLOWED_ROOTS=__INITIALIZED_BY_MAKE_INIT__

POSTGRES_DB=kodesec
POSTGRES_USER=kodesec

CONTROL_PORT=8080

# Immutable scanner-image build pins. Changing one is a source change that must
# update the reviewed tool lock and checksums, rebuild the image, and pass the
# full offline scanner matrix. Runtime cache updates never rewrite these pins.
TRIVY_VERSION=0.73.0
GITLEAKS_VERSION=8.30.1
GRYPE_VERSION=0.117.0
SYFT_VERSION=1.51.0
BEARER_VERSION=2.1.0+lomo.1
TRUFFLEHOG_VERSION=3.96.0
OPENGREP_VERSION=1.27.0
CHECKOV_VERSION=3.3.10
# D-020: host-owned preparation lane; previously issued clocks never renew.
# New preparation uses mac (1200s), linux (3120s), or windows/WSL (4680s).
KODESEC_PREPARATION_PLATFORM=__INITIALIZED_PREPARATION_PLATFORM__
KODESEC_SCANNER_TOOLS_TIMEOUT=45
# Mac-reference seconds; the scanner applies the selected platform factor once.
KODESEC_EXTERNAL_TOOL_TIMEOUT=300
KODESEC_EXTERNAL_TOOL_NICE=10
SCANNER_CPUS=2.0
SCANNER_MEMORY_LIMIT=4g
SCANNER_PIDS_LIMIT=512

# Ollama always runs outside Docker. Native macOS Ollama can use Metal acceleration.
# Auto means: use Ollama when /api/tags is reachable, otherwise continue without AI.
KODESEC_AI_MODE=auto
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional comma-separated exact hosts (no CIDRs or wildcards) for a reviewed local relay.
KODESEC_OLLAMA_ALLOWED_HOSTS=
OLLAMA_MODEL=qwen3:8b
OLLAMA_MODEL_DIGEST=
KODESEC_OLLAMA_THINKING=false
KODESEC_AUTO_TRIAGE_LIMIT=5
# Managed runtime configuration schema. `make init` verifies this provenance
# marker before reusing an existing operator-owned runtime file.
KODESEC_RUNTIME_CONFIG_VERSION=1
# Provider routes are operator-authorized exact identities. The private
# connector is the only service that receives these safe host declarations.
KODESEC_ADVISOR_DIRECT_HOSTS=
KODESEC_ADVISOR_SSH_PROVIDER_IDS=
KODESEC_ADVISOR_AUTH_DIR=__INITIALIZED_ADVISOR_AUTH_DIR__
# A dedicated generated worker-to-connector execution-capability secret is
# appended to the owner-only runtime file by `make init`.
KODESEC_HOST_UID=__INITIALIZED_HOST_UID__
KODESEC_HOST_GID=__INITIALIZED_HOST_GID__

# `make init` gives each installation one explicit stable identity. Compose,
# image, and test-run names may be scoped independently without changing local
# browser/IDE ownership. Do not copy this template directly.
KODESEC_INSTALLATION_ID=__INITIALIZED_INSTALLATION_ID__
COMPOSE_PROJECT_NAME=__INITIALIZED_COMPOSE_PROJECT__
KODESEC_CONTROL_IMAGE=__INITIALIZED_CONTROL_IMAGE__
KODESEC_SCANNER_IMAGE=__INITIALIZED_SCANNER_IMAGE__

# Source-blind updater limits. The updater shares only the offline scanner-cache
# volume and has no source, artifact, database, advisor, or Docker access.
# Grype's source-blind v6 database import needs the compressed archive,
# staging copy, and final database concurrently. These measured bounds are
# independent of the scanner container and fail closed when host capacity is
# insufficient.
SCANNER_UPDATER_CPUS=2.0
SCANNER_UPDATER_MEMORY_LIMIT=4g
SCANNER_UPDATER_PIDS_LIMIT=256

# Optional service-image pins. `make pull-service-images` fetches these images;
# it does not update scanner binaries, databases, checks, or rule packs.
POSTGRES_IMAGE=postgres:16-alpine
GITEA_IMAGE=gitea/gitea:1.23-rootless
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana:11.4.0
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.2
ADMINER_IMAGE=adminer:4.8.1
# Local Git proxy profile bootstrap identity. Passwords and service secrets are
# generated into the owner-only runtime file by `make init`.
GITEA_TEST_USER=kodesec-test
