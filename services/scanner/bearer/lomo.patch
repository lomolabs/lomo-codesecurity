+func TestCacheEvictionPreservesBoundAndResults(t *testing.T) {
+	rule := ruleset.BuiltinDatatypeRule
+	c := &Cache{enabled: true, shared: NewShared(nil), data: make(map[*treepkg.Node][]entry)}
+	result := &detectorset.Result{}
+	nodes := make([]*treepkg.Node, maxCacheSize+2)
+	for i := range nodes {
+		nodes[i] = &treepkg.Node{}
+		c.Put(nodes[i], rule, result)
+	}
+	if got, want := len(c.data), maxCacheSize+2-evictionSize; got != want {
+		t.Fatalf("cache nodes after eviction = %d, want %d", got, want)
+	}
+	if got, ok := c.Get(nodes[len(nodes)-1], rule); !ok || got != result {
+		t.Fatal("newest result was not retained")
+	}
+	retained := 0
+	for _, node := range nodes {
+		got, ok := c.Get(node, rule)
+		if ok {
+			retained++
+			if got != result {
+				t.Fatal("retained result changed")
+			}
+			if entries := c.data[node]; len(entries) != 1 {
+				t.Fatal("retained entry changed")
+			}
+		}
+	}
+	if retained != len(c.data) {
+		t.Fatalf("retained results = %d, map nodes = %d", retained, len(c.data))
+	}
+	c.Put(nodes[len(nodes)-1], rule, result)
+	if entries := c.data[nodes[len(nodes)-1]]; len(entries) != 2 {
+		t.Fatal("same-node append changed")
+	}
+	c.Clear()
+	if len(c.data) != 0 {
+		t.Fatal("clear retained entries")
+	}
+}
