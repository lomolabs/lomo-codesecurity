+package query
+
+import "github.com/bearer/bearer/pkg/scanner/ast/tree"
+
+// This exact generated JavaScript query has one pattern and no predicates or
+// adjacency constraint. Its matches are every ordered pair of named siblings.
+const statementPair = "([(statement_block  [(_)] @param1 [(_)] @param2 @match )(program  [(_)] @param3 [(_)] @param4 @match )] @root)"
+const statementPairCandidates = "([(statement_block (_) @match)(program (_) @match)] @root)"
+
+func (q *Query) isStatementPair() bool {
+	return q.querySet.languageID == "javascript" && q.input == statementPair
+}
+
+func (q *Query) compiledInput() string {
+	if q.isStatementPair() {
+		return statementPairCandidates
+	}
+	return q.input
+}
+
+// Keep only the possible second sibling during AST collection. Materialize
+// the original captures on demand, without caching a quadratic set of pairs.
+func statementPairs(node *tree.Node, candidates []tree.QueryResult) []tree.QueryResult {
+	var results []tree.QueryResult
+	for _, candidate := range candidates {
+		root := candidate["root"]
+		first, second := "param1", "param2"
+		if root.Type() == "program" {
+			first, second = "param3", "param4"
+		}
+		for _, previous := range root.Children() {
+			if previous == node {
+				break
+			}
+			if !previous.IsNamed() || previous.IsError() {
+				continue
+			}
+			results = append(results, tree.QueryResult{
+				"root": root, "match": node, first: previous, second: node,
+			})
+		}
+	}
+	return results
+}
