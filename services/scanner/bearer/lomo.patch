+func TestEmptyScanEligibilityRequiresWholeShapeNotID(t *testing.T) {
+	for _, ids := range [][2]string{{"javascript_express_static_asset_with_session_session", "javascript_express_static_asset_with_session_session_init"}, {"renamed_parent", "renamed_leaf"}} {
+		input := shapeFixture(ids[0], ids[1])
+		if !shapeRule(t, input, ids[0]).EmptyScanMemoEligible() {
+			t.Fatal("reviewed shape refused under a consistent reference rename")
+		}
+	}
+	changes := map[string]func(map[string]*settings.Rule){
+		"parent_pattern": func(x map[string]*settings.Rule) { x["parent"].Patterns[0].Pattern = "other()" },
+		"leaf_pattern":   func(x map[string]*settings.Rule) { x["leaf"].Patterns[0].Pattern = "other()" },
+		"scope":          func(x map[string]*settings.Rule) { x["parent"].Patterns[0].Filters[0].Scope = settings.CURSOR_SCOPE },
+		"focus":          func(x map[string]*settings.Rule) { x["parent"].Patterns[0].Focus = "SESSION_MIDDLEWARE" },
+		"cycle":          func(x map[string]*settings.Rule) { x["parent"].Patterns[0].Filters[0].Detection = "parent" },
+		"missing_child":  func(x map[string]*settings.Rule) { delete(x, "leaf") },
+		"child_identity": func(x map[string]*settings.Rule) { x["leaf"].Id = "different" },
+		"imports": func(x map[string]*settings.Rule) {
+			x["parent"].Patterns[0].Filters[0].Imports = []settings.RuleReferenceImport{{Variable: "child", As: "parent"}}
+		},
+		"source":          func(x map[string]*settings.Rule) { x["parent"].Patterns[0].Filters[0].IsSource = true },
+		"sanitizer":       func(x map[string]*settings.Rule) { x["parent"].SanitizerRuleID = "leaf" },
+		"child_sanitizer": func(x map[string]*settings.Rule) { x["leaf"].SanitizerRuleID = "parent" },
+		"shared":          func(x map[string]*settings.Rule) { x["parent"].Type = customdetectors.TypeShared },
+		"parenting":       func(x map[string]*settings.Rule) { x["parent"].ParamParenting = true },
+		"stored":          func(x map[string]*settings.Rule) { x["parent"].Stored = true },
+		"languages":       func(x map[string]*settings.Rule) { x["parent"].Languages = []string{"javascript", "ruby"} },
+		"trigger":         func(x map[string]*settings.Rule) { x["leaf"].Trigger.RequiredDetections = []string{"parent"} },
+		"presence":        func(x map[string]*settings.Rule) { x["leaf"].DetectPresence = true },
+		"not":             func(x map[string]*settings.Rule) { x["parent"].Patterns[0].Filters[0].Not = &settings.PatternFilter{} },
+		"either": func(x map[string]*settings.Rule) {
+			x["parent"].Patterns[0].Filters[0].Either = []settings.PatternFilter{{}}
+		},
+	}
+	for name, change := range changes {
+		t.Run(name, func(t *testing.T) {
+			input := shapeFixture("parent", "leaf")
+			change(input)
+			if reviewedEmptyScanClosure("javascript", input["parent"], input) != nil {
