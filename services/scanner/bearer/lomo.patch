+
+func pairFixture(t *testing.T, source string, optimized bool) (*Query, *tree.Tree) {
+	t.Helper()
+	lang := tsx.GetLanguage()
+	p := sitter.NewParser()
+	p.SetLanguage(lang)
+	t.Cleanup(p.Close)
+	parsed, err := p.ParseCtx(context.Background(), nil, []byte(source))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(parsed.Close)
+	builder := tree.NewBuilder(lang, []byte(source), parsed.RootNode(), 0, nil)
+	set := NewSet("javascript", lang)
+	t.Cleanup(set.Close)
+	// Whitespace leaves the native query identical but bypasses exact admission.
+	input := statementPair
+	if !optimized {
+		input += "\n"
+	}
+	q := set.Add(input)
+	set.Add("(identifier) @root") // subsequent pattern IDs must remain intact
+	if err := set.Compile(); err != nil {
+		t.Fatal(err)
+	}
+	if set.sitterQuery.PatternCount() != 2 {
+		t.Fatal("pattern indexes changed")
+	}
+	if err := set.Query(context.Background(), builder, parsed.RootNode()); err != nil {
+		t.Fatal(err)
+	}
+	return q, builder.Build()
+}
+
+func pairProjection(results []tree.QueryResult) string {
+	rows := make([]map[string]int, len(results))
+	for i, result := range results {
+		rows[i] = map[string]int{}
+		for k, n := range result {
+			rows[i][k] = n.ID
+		}
+	}
+	raw, _ := json.Marshal(rows)
+	return string(raw)
+}
+
+func TestStatementPairsNativeDifferential(t *testing.T) {
+	prior := zerolog.GlobalLevel()
+	zerolog.SetGlobalLevel(zerolog.InfoLevel)
+	t.Cleanup(func() { zerolog.SetGlobalLevel(prior) })
+	samples := []string{"", "a();", "a(); b(); c(); d();", "{a(); b(); c();}", "// top\na(); /*middle*/ b(); // tail\nc();", "function f(){a(); {b(); c();} d();} e();", "const α=1;\n\tconst β=2;", "if (a) {b(); c();} else {d(); e();}", "a(); ; ; b();", "{ a(); ??? b(); }", "const f = () => { a(); b(); }; class X { f(){ a(); b(); } }"}
+	for n := 2; n <= 24; n++ {
+		samples = append(samples, "function f(){"+strings.Repeat("a();\n", n)+"}")
+	}
+	tokens := []string{"a();", "//comment\n", "const b = ;", "???", "/*c*/", ";", "const c = 3;", "function f(){a(); b();}", "if( ){x();}"}
+	for seed := 0; seed < 100; seed++ {
+		var code strings.Builder
+		code.WriteString("{")
+		for j := 0; j < 8; j++ {
+			code.WriteString(tokens[(seed*(j+1)+j*j)%len(tokens)])
+			code.WriteString("\n")
+		}
+		code.WriteString("}")
+		samples = append(samples, code.String())
+	}
+	for i, source := range samples {
+		t.Run(fmt.Sprint(i), func(t *testing.T) {
+			old, a := pairFixture(t, source, false)
+			next, b := pairFixture(t, source, true)
+			if a.NodeCount() != b.NodeCount() {
+				t.Fatal("node count")
+			}
+			for j := range a.Nodes() {
+				x, y := &a.Nodes()[j], &b.Nodes()[j]
+				got, want := pairProjection(next.MatchAt(y)), pairProjection(old.MatchAt(x))
+				if got != want {
+					t.Fatalf("node%d %s got %s want %s", j, x.Type(), got, want)
+				}
+				if pairProjection(x.QueryResults(1)) != pairProjection(y.QueryResults(1)) {
+					t.Fatal("later pattern changed")
+				}
+				r1, e1 := old.MatchOnceAt(x)
+				r2, e2 := next.MatchOnceAt(y)
+				if (e1 == nil) != (e2 == nil) || pairProjection([]tree.QueryResult{r1}) != pairProjection([]tree.QueryResult{r2}) {
+					t.Fatal("cardinality changed")
+				}
+			}
+		})
+	}
+}
+
+func TestStatementPairsExactAdmissionAndCancellation(t *testing.T) {
+	s := NewSet("javascript", tsx.GetLanguage())
+	defer s.Close()
+	q := s.Add(statementPair)
+	if !q.isStatementPair() {
+		t.Fatal("exact rejected")
+	}
+	for _, input := range []string{statementPair + "\n", strings.Replace(statementPair, "param1", "other", 1), strings.Replace(statementPair, " [(_)] @param2", ". [(_)] @param2", 1)} {
+		if s.Add(input).isStatementPair() {
+			t.Fatal("changed accepted")
+		}
+	}
+	other := NewSet("typescript", tsx.GetLanguage())
+	defer other.Close()
+	if other.Add(statementPair).isStatementPair() {
+		t.Fatal("language widened")
+	}
+	c := NewSet("javascript", tsx.GetLanguage())
+	defer c.Close()
+	c.Add(statementPair)
+	if err := c.Compile(); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	p := sitter.NewParser()
+	defer p.Close()
+	p.SetLanguage(tsx.GetLanguage())
+	parsed, err := p.ParseCtx(context.Background(), nil, []byte("a(); b();"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer parsed.Close()
+	builder := tree.NewBuilder(tsx.GetLanguage(), []byte("a(); b();"), parsed.RootNode(), 0, nil)
+	if !errors.Is(c.Query(ctx, builder, parsed.RootNode()), context.Canceled) {
+		t.Fatal("cancellation lost")
+	}
+	if !reflect.DeepEqual(q, s.Add(statementPair)) {
+		t.Fatal("dedup changed")
+	}
+}
