+func TestPatternAllSkipsOnlyUnreachableOuterChild(t *testing.T) {
+	first := &countedFilter{result: filters.NewResult()}
+	later := &countedFilter{err: errors.New("unreachable error")}
+	conjunction := &filters.PatternAll{All: &filters.All{Children: []filters.Filter{first, later}}}
+	result, err := conjunction.Evaluate(nil, nil)
+	if err != nil || result == nil || len(result.Matches()) != 0 || first.calls != 1 || later.calls != 0 {
+		t.Fatalf("dead branch still evaluated or altered result: result=%v error=%v calls=%d/%d", result, err, first.calls, later.calls)
+	}
+}
+
+func TestPatternAllPreservesLiveErrorsAndUnknown(t *testing.T) {
+	node := &tree.Node{}
+	live := &countedFilter{result: filters.NewResult(filters.NewMatch(variableshape.Values{node}, "", nil))}
+	want := errors.New("cycle found during rule evaluation")
+	later := &countedFilter{err: want}
+	conjunction := &filters.PatternAll{All: &filters.All{Children: []filters.Filter{live, later}}}
+	if result, err := conjunction.Evaluate(nil, nil); result != nil || !errors.Is(err, want) || later.calls != 1 {
+		t.Fatalf("live branch error suppressed: result=%v error=%v calls=%d", result, err, later.calls)
+	}
+	unknown := &countedFilter{result: nil}
+	later.calls = 0
+	conjunction = &filters.PatternAll{All: &filters.All{Children: []filters.Filter{unknown, later}}}
+	if result, err := conjunction.Evaluate(nil, nil); result != nil || err != nil || later.calls != 0 {
+		t.Fatalf("unknown branch changed: result=%v error=%v calls=%d", result, err, later.calls)
+	}
+}
+
+func TestPatternAllPreservesSharedBindingAndDiscordance(t *testing.T) {
+	node, other := &tree.Node{}, &tree.Node{}
+	first := &countedFilter{result: filters.NewResult(filters.NewMatch(variableshape.Values{node, nil}, "", nil))}
+	second := &countedFilter{result: filters.NewResult(filters.NewMatch(variableshape.Values{nil, node}, "", nil))}
+	conjunction := &filters.PatternAll{All: &filters.All{Children: []filters.Filter{first, second}}}
+	result, err := conjunction.Evaluate(nil, nil)
+	if err != nil || result == nil || len(result.Matches()) != 1 || first.calls != 1 || second.calls != 1 {
+		t.Fatalf("shared binding lost: result=%v error=%v calls=%d/%d", result, err, first.calls, second.calls)
+	}
+	second.result = filters.NewResult(filters.NewMatch(variableshape.Values{other, nil}, "", nil))
+	result, err = conjunction.Evaluate(nil, nil)
+	if err != nil || result == nil || len(result.Matches()) != 0 || second.calls != 2 {
+		t.Fatalf("discordant binding changed: result=%v error=%v calls=%d", result, err, second.calls)
+	}
