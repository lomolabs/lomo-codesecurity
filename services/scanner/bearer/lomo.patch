+func TestNestedAllKeepsLaterUnknownAndErrorSemantics(t *testing.T) {
+	first := &countedFilter{result: filters.NewResult()}
+	second := &countedFilter{result: nil}
+	nested := &filters.All{Children: []filters.Filter{first, second}}
+	if result, err := nested.Evaluate(nil, nil); result != nil || err != nil || second.calls != 1 {
+		t.Fatalf("nested unknown changed: result=%v error=%v calls=%d", result, err, second.calls)
