diff --git a/pkg/commands/process/settings/platform.go b/pkg/commands/process/settings/platform.go
new file mode 100644
--- /dev/null
+++ b/pkg/commands/process/settings/platform.go
@@ -0,0 +1,35 @@
+package settings
+
+import (
+	"fmt"
+	"time"
+)
+
+// ScanTimeout preserves the independent Mac cap and extends only new VM work.
+func ScanTimeout(factor int) time.Duration {
+	switch factor {
+	case 10:
+		return Timeout
+	case 52:
+		return Timeout * 26 / 10
+	case 78:
+		return Timeout * 39 / 10
+	default:
+		panic("invalid scanner timeout factor")
+	}
+}
+
+// FileTimeoutFactor returns exact tenths for the installation-owned lanes.
+// Empty preserves upstream timing; native Windows and Remote WSL both use windows.
+func FileTimeoutFactor(platform string) (int, error) {
+	switch platform {
+	case "", "mac":
+		return 10, nil
+	case "linux":
+		return 52, nil
+	case "windows":
+		return 78, nil
+	default:
+		return 0, fmt.Errorf("invalid scanner platform")
+	}
+}
diff --git a/pkg/commands/process/settings/platform_test.go b/pkg/commands/process/settings/platform_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/commands/process/settings/platform_test.go
@@ -0,0 +1,38 @@
+package settings
+
+import (
+	"testing"
+	"time"
+)
+
+func TestFileTimeoutPlatform(t *testing.T) {
+	for platform, expected := range map[string]int{"": 10, "mac": 10, "linux": 52, "windows": 78} {
+		actual, err := FileTimeoutFactor(platform)
+		if err != nil || actual != expected {
+			t.Fatalf("%q: %d %v", platform, actual, err)
+		}
+	}
+	for _, platform := range []string{"Linux", "wsl", "2", " linux", "linux\n", "unlimited"} {
+		if actual, err := FileTimeoutFactor(platform); err == nil || actual != 0 {
+			t.Fatalf("accepted %q", platform)
+		}
+	}
+}
+
+func TestScanTimeoutKeepsIndependentCap(t *testing.T) {
+	for factor, expected := range map[int]time.Duration{10: 600 * time.Second, 52: 1560 * time.Second, 78: 2340 * time.Second} {
+		if actual := ScanTimeout(factor); actual != expected {
+			t.Fatalf("factor=%d got=%v want=%v", factor, actual, expected)
+		}
+	}
+	for _, factor := range []int{0, 1, -1, 26, 39, 40} {
+		func() {
+			defer func() {
+				if recover() == nil {
+					t.Errorf("accepted factor %d", factor)
+				}
+			}()
+			ScanTimeout(factor)
+		}()
+	}
+}
