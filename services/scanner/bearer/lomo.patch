+	input := shapeFixture("parent", "leaf")
+	input["leaf"].Patterns[0].Filters = []settings.PatternFilter{{Variable: "ARG", Detection: "parent", Scope: settings.NESTED_SCOPE}}
+	if reviewedEmptyScanClosure("javascript", input["parent"], input) != nil {
+		t.Fatal("leaf dependency cycle authorized")
+	}
