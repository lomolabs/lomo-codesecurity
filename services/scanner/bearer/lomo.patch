+package detectorset
+
+import (
+	"context"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/bearer/bearer/pkg/commands/process/settings"
+	"github.com/bearer/bearer/pkg/scanner/ast/traversalstrategy"
+	"github.com/bearer/bearer/pkg/scanner/ast/tree"
+	detectortypes "github.com/bearer/bearer/pkg/scanner/detectors/types"
+	"github.com/bearer/bearer/pkg/scanner/ruleset"
+	sitter "github.com/smacker/go-tree-sitter"
+	"github.com/smacker/go-tree-sitter/javascript"
+)
+
+type emptyResultDetector struct {
+	rule  *ruleset.Rule
+	data  []interface{}
+	calls int
+}
+
+func (detector *emptyResultDetector) Rule() *ruleset.Rule { return detector.rule }
+func (detector *emptyResultDetector) DetectAt(*tree.Node, detectortypes.Context) ([]interface{}, error) {
+	detector.calls++
+	return detector.data, nil
+}
+func (detector *emptyResultDetector) DetectExpectedAt(*tree.Node, detectortypes.Context) ([]interface{}, error) {
+	return nil, nil
+}
+
+type emptyResultContext struct{ sanitized bool }
+
+func (ctx emptyResultContext) Filename() string { return "fixture.js" }
+func (ctx emptyResultContext) Scan(node *tree.Node, _ *ruleset.Rule, _ traversalstrategy.Strategy) ([]*detectortypes.Detection, error) {
+	if ctx.sanitized {
+		return []*detectortypes.Detection{{MatchNode: node}}, nil
+	}
+	return nil, nil
+}
+
+func TestEmptyResultMissAndPositiveAndSanitized(t *testing.T) {
+	rules, err := ruleset.New("javascript", map[string]*settings.Rule{
+		"sink":  {Id: "sink", Languages: []string{"javascript"}, SanitizerRuleID: "clean"},
+		"clean": {Id: "clean", Languages: []string{"javascript"}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rule, err := rules.RuleByID("sink")
+	if err != nil {
+		t.Fatal(err)
+	}
+	detector := &emptyResultDetector{rule: rule}
+	set := &detectorSet{detectors: make([]detectortypes.Detector, len(rules.Rules())), active: make([]atomic.Int64, len(rules.Rules()))}
+	set.detectors[rule.Index()] = detector
+	node := &tree.Node{}
+
+	got, err := set.DetectAt(node, rule, emptyResultContext{})
+	if err != nil || got != nil || detector.calls != 1 || len(node.ExecutingDetectors) != 0 {
+		t.Fatalf("empty miss changed: result=%v err=%v calls=%d executing=%d", got, err, detector.calls, len(node.ExecutingDetectors))
+	}
+
+	detector.data = []interface{}{"positive"}
+	got, err = set.DetectAt(node, rule, emptyResultContext{})
+	if err != nil || got == nil || got.Sanitized || len(got.Detections) != 1 ||
+		got.Detections[0].RuleID != rule.ID() || got.Detections[0].MatchNode != node ||
+		got.Detections[0].Data != "positive" || detector.calls != 2 {
+		t.Fatalf("positive detection changed: result=%v err=%v calls=%d", got, err, detector.calls)
+	}
+
+	got, err = set.DetectAt(node, rule, emptyResultContext{sanitized: true})
+	if err != nil || got == nil || !got.Sanitized || len(got.Detections) != 0 || detector.calls != 2 {
+		t.Fatalf("sanitized detection changed: result=%v err=%v calls=%d", got, err, detector.calls)
+	}
+}
+
+func TestLiveDetectorCycleRemainsAnError(t *testing.T) {
+	rules, err := ruleset.New("javascript", map[string]*settings.Rule{
+		"sink": {Id: "sink", Languages: []string{"javascript"}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rule, err := rules.RuleByID("sink")
+	if err != nil {
+		t.Fatal(err)
+	}
+	detector := &emptyResultDetector{rule: rule}
+	set := &detectorSet{detectors: make([]detectortypes.Detector, len(rules.Rules())), active: make([]atomic.Int64, len(rules.Rules()))}
+	set.detectors[rule.Index()] = detector
+	parsed, err := sitter.ParseCtx(context.Background(), []byte("const value = 1"), javascript.GetLanguage())
+	if err != nil {
+		t.Fatal(err)
+	}
+	node := tree.NewBuilder(javascript.GetLanguage(), []byte("const value = 1"), parsed, 5, nil).Build().RootNode()
+	node.ExecutingDetectors = []int{rule.Index()}
+	got, err := set.DetectAt(node, rule, emptyResultContext{})
+	if got != nil || err == nil || !strings.Contains(err.Error(), "cycle found during rule evaluation") || detector.calls != 0 || len(node.ExecutingDetectors) != 1 {
+		t.Fatalf("live cycle changed: result=%v error=%v calls=%d stack=%v", got, err, detector.calls, node.ExecutingDetectors)
+	}
+}
