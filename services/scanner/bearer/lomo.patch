+package rulescanner_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/bearer/bearer/pkg/commands/process/settings"
+	"github.com/bearer/bearer/pkg/languages/javascript"
+	"github.com/bearer/bearer/pkg/report/customdetectors"
+	"github.com/bearer/bearer/pkg/scanner/ast"
+	"github.com/bearer/bearer/pkg/scanner/ast/query"
+	"github.com/bearer/bearer/pkg/scanner/ast/traversalstrategy"
+	"github.com/bearer/bearer/pkg/scanner/ast/tree"
+	"github.com/bearer/bearer/pkg/scanner/cache"
+	detectortypes "github.com/bearer/bearer/pkg/scanner/detectors/types"
+	"github.com/bearer/bearer/pkg/scanner/detectorset"
+	"github.com/bearer/bearer/pkg/scanner/rulescanner"
+	"github.com/bearer/bearer/pkg/scanner/ruleset"
+	"github.com/bearer/bearer/pkg/scanner/variableshape"
+	"github.com/rs/zerolog"
+)
+
+// A wrapper gives OFF exactly the same real compiled detectors and normal
+// node cache, while the production guard fails closed for its unknown type.
+type memoOff struct{ detectorset.Set }
+
+type realFixture struct {
+	ast      *tree.Tree
+	rules    *ruleset.Set
+	rule     *ruleset.Rule
+	compiled detectorset.Set
+	scanner  *rulescanner.Scanner
+	memo     *cache.Cache
+}
+
+func realMemoFixture(t *testing.T, ctx context.Context, src string, statements int, off bool, change func(map[string]*settings.Rule)) realFixture {
+	t.Helper()
+	prior := zerolog.GlobalLevel()
+	zerolog.SetGlobalLevel(zerolog.InfoLevel)
+	t.Cleanup(func() { zerolog.SetGlobalLevel(prior) })
+	lang := javascript.Get()
+	input := map[string]*settings.Rule{
+		"parent": {Id: "parent", Type: customdetectors.TypeVerifier, Languages: []string{"javascript"}, IsAuxilary: true, Patterns: []settings.RulePattern{{Pattern: "app.use($<SESSION_MIDDLEWARE>)", Filters: []settings.PatternFilter{{Variable: "SESSION_MIDDLEWARE", Detection: "leaf", Scope: settings.RESULT_SCOPE}}}}},
+		"leaf":   {Id: "leaf", Type: customdetectors.TypeVerifier, Languages: []string{"javascript"}, IsAuxilary: true, Patterns: []settings.RulePattern{{Pattern: "session()"}}},
+	}
+	if change != nil {
+		change(input)
+	}
+	rs, err := ruleset.New("javascript", input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	vs, err := variableshape.NewSet(lang, rs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	qs := query.NewSet(lang.ID(), lang.SitterLanguage())
+	t.Cleanup(qs.Close)
+	ds, err := detectorset.New(nil, lang, rs, vs, qs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := qs.Compile(); err != nil {
+		t.Fatal(err)
+	}
+	var content strings.Builder
+	content.WriteString(src)
+	content.WriteString("\n")
+	for i := 0; i < statements; i++ {
+		fmt.Fprintf(&content, "const value%d = %d;\n", i, i)
+	}
+	tr, err := ast.ParseAndAnalyze(context.Background(), lang, rs, qs, []byte(content.String()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	rule, err := rs.RuleByID("parent")
+	if err != nil {
+		t.Fatal(err)
+	}
+	memo := cache.NewCache(tr, cache.NewShared(rs.Rules()))
+	actual := ds
+	if off {
+		actual = memoOff{ds}
+	}
+	return realFixture{tr, rs, rule, ds, rulescanner.New(ctx, actual, "memo.js", nil, traversalstrategy.NewCache(tr.NodeCount()), memo), memo}
+}
+
+func scanProjection(t *testing.T, f realFixture, scope traversalstrategy.Strategy) (string, error) {
+	t.Helper()
+	found, err := f.scanner.Scan(f.ast.RootNode(), f.rule, scope)
+	// Full ordered detector data, rule identity, node and variable positions are
+	// included; independent ASTs have the same IDs and no mutable private fields.
+	encoded, e := json.Marshal(found)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return string(encoded), err
+}
+
+func TestRealEmptyMemoDifferentialFindingsAndActualReuse(t *testing.T) {
+	cases := []struct {
+		name, source string
+		positive     bool
+	}{
+		{"negative", "app.use(other());", false},
+		{"positive", "app.use(session());", true},
+		{"nested", "function configure() { app.use(session()); }", true},
+		{"multiple", "app.use(session()); app.use(other()); app.use(session());", true},
+		{"alias", "const middleware = session(); app.use(middleware);", true},
+		{"disabled", "// bearer:disable parent\napp.use(session());", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			on := realMemoFixture(t, context.Background(), tc.source, 3500, false, nil)
+			off := realMemoFixture(t, context.Background(), tc.source, 3500, true, nil)
+			if on.ast.NodeCount() <= 20000 || on.ast.NodeCount() > 250000 {
+				t.Fatalf("invalid active fixture %d", on.ast.NodeCount())
+			}
+			for pass := 0; pass < 3; pass++ {
+				a, ae := scanProjection(t, on, traversalstrategy.Nested)
+				b, be := scanProjection(t, off, traversalstrategy.Nested)
+				if a != b || ae != nil || be != nil {
+					t.Fatalf("pass %d changed ordered output/errors: %s/%v vs %s/%v", pass, a, ae, b, be)
+				}
+				if tc.positive && (a == "null" || a == "[]") {
+					t.Fatal("positive fixture produced no real detection")
+				}
+				if tc.positive {
+					assertNoClosureProof(t, on)
+				}
+			}
+			hits, records := on.memo.EmptyScanMemoCounts()
+			offHits, offRecords := off.memo.EmptyScanMemoCounts()
+			if offHits != 0 || offRecords != 0 {
+				t.Fatal("OFF reused memo")
+			}
+			if tc.positive && (hits != 0 || records != 0) {
+				t.Fatal("positive scan memoized")
+			}
+			if !tc.positive && (hits != 2 || records != 1) {
+				t.Fatalf("negative did not actually reuse exact root: hits=%d records=%d", hits, records)
+			}
+		})
+	}
+}
+
+func TestRealMemoClearScopeCancellationAndOwnerFence(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	f := realMemoFixture(t, ctx, "app.use(other());", 3500, false, nil)
+	if _, err := scanProjection(t, f, traversalstrategy.Nested); err != nil {
+		t.Fatal(err)
+	}
+	owner := detectorset.EmptyScanMemoSafety(f.compiled, f.rule)
+	if owner == nil {
+		t.Fatal("real immutable compiled closure rejected")
+	}
+	if !f.memo.EmptyScanCached(f.ast.RootNode(), f.rule, owner) {
+		t.Fatal("missing exact-root memo")
+	}
+	if !f.memo.EmptyScanCached(f.ast.RootNode().Children()[0], f.rule, owner) {
+		t.Fatal("completed empty traversal did not retain descendant proof")
+	}
+	if f.memo.EmptyScanCached(f.ast.RootNode(), f.rule, nil) {
+		t.Fatal("unknown owner reused memo")
+	}
+	otherFixture := realMemoFixture(t, context.Background(), "app.use(other());", 3500, false, nil)
+	if f.memo.EmptyScanCached(otherFixture.ast.RootNode(), f.rule, owner) || f.memo.EmptyScanCached(f.ast.RootNode(), otherFixture.rule, owner) {
+		t.Fatal("another AST or same-ID different Rule reused memo")
+	}
+	// Compile another detector set from the exact same immutable Rule objects.
+	lang := javascript.Get()
+	vs, err := variableshape.NewSet(lang, f.rules)
+	if err != nil {
+		t.Fatal(err)
+	}
+	qs := query.NewSet(lang.ID(), lang.SitterLanguage())
+	defer qs.Close()
+	other, err := detectorset.New(nil, lang, f.rules, vs, qs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if f.memo.EmptyScanCached(f.ast.RootNode(), f.rule, detectorset.EmptyScanMemoSafety(other, f.rule)) {
+		t.Fatal("different compiled owner reused memo")
+	}
+	before, _ := f.memo.EmptyScanMemoCounts()
+	if _, err := scanProjection(t, f, traversalstrategy.NestedStrict); err != nil {
+		t.Fatal(err)
+	}
+	after, _ := f.memo.EmptyScanMemoCounts()
+	if after != before {
+		t.Fatal("different traversal scope reused memo")
+	}
+	cancel()
+	if _, err := scanProjection(t, f, traversalstrategy.Nested); !errors.Is(err, context.Canceled) {
+		t.Fatalf("memo hid cancellation: %v", err)
+	}
+	f.memo.Clear()
+	if f.memo.EmptyScanCached(f.ast.RootNode(), f.rule, owner) {
+		t.Fatal("Clear retained bits")
+	}
+	assertNoClosureProof(t, f)
+}
+
+// Enter the actual compiled parent at a descendant, then re-enter Nested at
+// the root through its real leaf-reference callback. Original evaluation must
+// still report a cycle; a root-only active check would skip the whole walk.
+type recurseContext struct {
+	scan func(*tree.Node, *ruleset.Rule, traversalstrategy.Strategy) ([]*detectortypes.Detection, error)
+}
+
+func (c recurseContext) Filename() string { return "memo.js" }
+func (c recurseContext) Scan(n *tree.Node, r *ruleset.Rule, s traversalstrategy.Strategy) ([]*detectortypes.Detection, error) {
+	return c.scan(n, r, s)
+}
+
+func TestRealMemoPreservesActiveDescendantCycle(t *testing.T) {
+	var cycleErrors []string
+	for _, off := range []bool{false, true} {
+		f := realMemoFixture(t, context.Background(), "app.use(other());", 3500, off, nil)
+		if _, err := scanProjection(t, f, traversalstrategy.Nested); err != nil {
+			t.Fatal(err)
+		}
+		var app *tree.Node
+		for i := range f.ast.Nodes() {
+			n := &f.ast.Nodes()[i]
+			if n.Type() == "call_expression" && n.Content() == "app.use(other())" {
+				app = n
+				break
+			}
+		}
+		if app == nil {
+			t.Fatal("missing actual call")
+		}
+		// Recreate the proven completed-empty entry after clearing only ordinary
+		// entries, so randomized normal-cache eviction cannot weaken the oracle.
+		owner := detectorset.EmptyScanMemoSafety(f.compiled, f.rule)
+		f.memo.Clear()
+		if !f.memo.RecordEmptyScan(f.ast.RootNode(), f.rule, owner) {
+			t.Fatal("missing proven empty setup")
+		}
+		_, err := f.compiled.DetectAt(app, f.rule, recurseContext{func(_ *tree.Node, _ *ruleset.Rule, _ traversalstrategy.Strategy) ([]*detectortypes.Detection, error) {
+			return f.scanner.Scan(f.ast.RootNode(), f.rule, traversalstrategy.Nested)
+		}})
+		if err == nil || !strings.Contains(err.Error(), "cycle found during rule evaluation") {
+			t.Fatalf("OFF=%v descendant cycle suppressed: %v", off, err)
+		}
+		if detectorset.EmptyScanMemoSafety(f.compiled, f.rule) == nil {
+			t.Fatal("active tracker not unwound after error")
+		}
+		cycleErrors = append(cycleErrors, err.Error())
+	}
+	if len(cycleErrors) != 2 || cycleErrors[0] != cycleErrors[1] {
+		t.Fatalf("cycle error text changed: %v", cycleErrors)
+	}
+}
+
+func TestRealMemoUnsupportedClosureAndBoundsFallback(t *testing.T) {
+	cases := []struct {
+		name   string
+		count  int
+		change func(map[string]*settings.Rule)
+	}{
+		{"small", 2, nil}, {"oversize", 45000, nil},
+		{"same_id_altered_leaf", 3500, func(x map[string]*settings.Rule) { x["leaf"].Patterns[0].Pattern = "other()" }},
+		{"leaf_sanitizer", 3500, func(x map[string]*settings.Rule) { x["leaf"].SanitizerRuleID = "parent" }},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if tc.name == "oversize" && testing.Short() {
+				t.Skip("large AST cap fixture")
+			}
+			on := realMemoFixture(t, context.Background(), "app.use(other());", tc.count, false, tc.change)
+			off := realMemoFixture(t, context.Background(), "app.use(other());", tc.count, true, tc.change)
+			for pass := 0; pass < 2; pass++ {
+				a, ae := scanProjection(t, on, traversalstrategy.Nested)
+				b, be := scanProjection(t, off, traversalstrategy.Nested)
+				if a != b || fmt.Sprint(ae) != fmt.Sprint(be) {
+					t.Fatalf("fallback changed semantics: %s/%v vs %s/%v", a, ae, b, be)
+				}
+			}
+			hits, records := on.memo.EmptyScanMemoCounts()
+			if hits != 0 || records != 0 {
+				t.Fatal("ineligible/capped traversal memoized")
+			}
+		})
+	}
+}
+
+// Deterministic cooperative cancellation partway through a real traversal.
+// AST preparation uses another context, so the counter covers scan work only.
+type countdownContext struct {
+	context.Context
+	checks, limit int
+}
+
+func (c *countdownContext) Err() error {
+	c.checks++
+	if c.checks >= c.limit {
+		return context.Canceled
+	}
+	return nil
+}
+func TestRealMemoNeverRecordsIncompleteTraversal(t *testing.T) {
+	for _, off := range []bool{false, true} {
+		ctx := &countdownContext{Context: context.Background(), limit: 10}
+		f := realMemoFixture(t, ctx, "app.use(other());", 3500, off, nil)
+		_, err := scanProjection(t, f, traversalstrategy.Nested)
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("OFF=%v incomplete scan lost cancellation: %v", off, err)
+		}
+		hits, records := f.memo.EmptyScanMemoCounts()
+		if hits != 0 || records != 0 {
+			t.Fatal("incomplete traversal recorded/reused")
+		}
+		assertNoClosureProof(t, f)
+	}
+}
+
+func TestRealMemoCompletedClosureReusesDescendants(t *testing.T) {
+	f := realMemoFixture(t, context.Background(), "function irrelevant(){app.use(other());}", 3500, false, nil)
+	if _, err := scanProjection(t, f, traversalstrategy.Nested); err != nil {
+		t.Fatal(err)
+	}
+	before, records := f.memo.EmptyScanMemoCounts()
+	var child *tree.Node
+	for i := range f.ast.Nodes() {
+		n := &f.ast.Nodes()[i]
+		if n.Type() == "call_expression" {
+			child = n
+			break
+		}
+	}
+	if child == nil {
+		t.Fatal("missing actual child")
+	}
+	found, err := f.scanner.Scan(child, f.rule, traversalstrategy.Nested)
+	if err != nil || len(found) != 0 {
+		t.Fatalf("completed empty descendant changed: %v %v", found, err)
+	}
+	after, nextRecords := f.memo.EmptyScanMemoCounts()
+	if after != before+1 || nextRecords != records {
+		t.Fatal("descendant did not reuse completed closure")
+	}
+}
+
+func TestRealMemoEmptyBranchDoesNotHidePositiveSibling(t *testing.T) {
+	source := "function irrelevant(){app.use(other());} app.use(session());"
+	on := realMemoFixture(t, context.Background(), source, 3500, false, nil)
+	off := realMemoFixture(t, context.Background(), source, 3500, true, nil)
+	var branch *tree.Node
+	for i := range on.ast.Nodes() {
+		n := &on.ast.Nodes()[i]
+		if n.Type() == "function_declaration" {
+			branch = n
+			break
+		}
+	}
+	if branch == nil {
+		t.Fatal("missing actual branch")
+	}
+	if found, err := on.scanner.Scan(branch, on.rule, traversalstrategy.Nested); err != nil || len(found) != 0 {
+		t.Fatalf("warm branch not empty: %v %v", found, err)
+	}
+	a, ae := scanProjection(t, on, traversalstrategy.Nested)
+	b, be := scanProjection(t, off, traversalstrategy.Nested)
+	if a != b || ae != nil || be != nil || a == "null" || a == "[]" {
+		t.Fatalf("positive sibling changed: %s/%v vs %s/%v", a, ae, b, be)
+	}
+}
+
+func assertNoClosureProof(t *testing.T, f realFixture) {
+	t.Helper()
+	owner := detectorset.EmptyScanMemoSafety(f.compiled, f.rule)
+	for i := range f.ast.Nodes() {
+		n := &f.ast.Nodes()[i]
+		if f.memo.EmptyScanCached(n, f.rule, owner) {
+			t.Fatalf("unexpected proof at descendant %d", n.ID)
+		}
+	}
+}
+
+func TestRealMemoNegativeAliasOutsideWarmSubtree(t *testing.T) {
+	source := "const middleware = other(); function configure(){ app.use(middleware); }"
+	on := realMemoFixture(t, context.Background(), source, 3500, false, nil)
+	off := realMemoFixture(t, context.Background(), source, 3500, true, nil)
+	var branch *tree.Node
+	for i := range on.ast.Nodes() {
+		n := &on.ast.Nodes()[i]
+		if n.Type() == "function_declaration" {
+			branch = n
+			break
+		}
+	}
+	if branch == nil {
+		t.Fatal("missing real function")
+	}
+	syntactic := map[int]bool{}
+	if err := traversalstrategy.NestedStrict.Traverse(traversalstrategy.NewCache(on.ast.NodeCount()), branch, func(n *tree.Node) (bool, error) { syntactic[n.ID] = true; return false, nil }); err != nil {
+		t.Fatal(err)
+	}
+	var external *tree.Node
+	if err := traversalstrategy.Nested.Traverse(traversalstrategy.NewCache(on.ast.NodeCount()), branch, func(n *tree.Node) (bool, error) {
+		if !syntactic[n.ID] && external == nil {
+			external = n
+		}
+		return false, nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if external == nil {
+		t.Fatal("fixture did not follow a real alias outside the warm syntax subtree")
+	}
+	for _, f := range []realFixture{on, off} {
+		found, err := f.scanner.Scan(&f.ast.Nodes()[branch.ID], f.rule, traversalstrategy.Nested)
+		if err != nil || len(found) != 0 {
+			t.Fatalf("warm scan not empty: %v %v", found, err)
+		}
+	}
+	before, records := on.memo.EmptyScanMemoCounts()
+	a, ae := on.scanner.Scan(external, on.rule, traversalstrategy.Nested)
+	b, be := off.scanner.Scan(&off.ast.Nodes()[external.ID], off.rule, traversalstrategy.Nested)
+	ax, _ := json.Marshal(a)
+	bx, _ := json.Marshal(b)
+	if string(ax) != string(bx) || ae != nil || be != nil {
+		t.Fatalf("external alias changed: %s/%v vs %s/%v", ax, ae, bx, be)
+	}
+	after, nextRecords := on.memo.EmptyScanMemoCounts()
+	if after != before+1 || nextRecords != records {
+		t.Fatal("external alias did not reuse completed empty proof")
+	}
+}
