+package ruleset
+
+// Lomo modification: memoize only the reviewed immutable auxiliary closure.
+import (
+	"reflect"
+
+	"github.com/bearer/bearer/pkg/commands/process/settings"
+	"github.com/bearer/bearer/pkg/report/customdetectors"
+)
+
+// IDs identify references inside the actual closure; no fixed ID authorizes
+// caching. Compare the entire settings Rule, including fields that today do
+// not participate in matching, so newly introduced semantics fail closed.
+// This intentionally accepts just the reviewed two-node acyclic shape.
+func reviewedEmptyScanClosure(languageID string, candidate *settings.Rule, settingsRules map[string]*settings.Rule) *settings.Rule {
+	if languageID != "javascript" || candidate == nil || len(candidate.Patterns) != 1 || len(candidate.Patterns[0].Filters) != 1 {
+		return nil
+	}
+	childID := candidate.Patterns[0].Filters[0].Detection
+	child := settingsRules[childID]
+	if child == nil || childID == "" || candidate.Id == childID || child.Id != childID {
+		return nil
+	}
+	expected := &settings.Rule{
+		Id: candidate.Id, Type: customdetectors.TypeVerifier,
+		Languages: []string{"javascript"}, IsAuxilary: true,
+		Patterns: []settings.RulePattern{{
+			Pattern: "app.use($<SESSION_MIDDLEWARE>)",
+			Filters: []settings.PatternFilter{{
+				Variable: "SESSION_MIDDLEWARE", Detection: childID, Scope: settings.RESULT_SCOPE,
+			}},
+		}},
+	}
+	expectedChild := &settings.Rule{
+		Id: childID, Type: customdetectors.TypeVerifier,
+		Languages: []string{"javascript"}, IsAuxilary: true,
+		Patterns: []settings.RulePattern{{Pattern: "session()"}},
+	}
+	if !reflect.DeepEqual(candidate, expected) || !reflect.DeepEqual(child, expectedChild) {
+		return nil
+	}
+	return child
+}
+
+// Called once after types and sanitizer bindings exist and before detector
+// compilation. Both referenced Rules must really be auxiliary, so a trigger
+// that promotes either node to a top-level rule disables the optimization.
+func bindReviewedEmptyScanClosure(languageID string, settingsRules map[string]*settings.Rule, actual map[string]*Rule) {
+	for _, rule := range actual {
+		if rule.ruleType != RuleTypeAuxiliary || rule.sanitizerRule != nil {
+			continue
+		}
+		childSettings := reviewedEmptyScanClosure(languageID, settingsRules[rule.id], settingsRules)
+		if childSettings == nil {
+			continue
+		}
+		child := actual[childSettings.Id]
+		if child == nil || child.ruleType != RuleTypeAuxiliary || child.sanitizerRule != nil {
+			continue
+		}
+		// Eligible slices contain only immutable strings, the exact one flat
+		// filter, and its strings. Deep copies detach all mutable slice aliases.
+		rule.patterns = copyReviewedPatterns(rule.patterns)
+		child.patterns = copyReviewedPatterns(child.patterns)
+		rule.emptyScanMemoEligible = true
+		rule.emptyScanMemoImmutable = true
+		child.emptyScanMemoImmutable = true
+		rule.emptyScanMemoLeaf = child
+	}
+}
+
+func copyReviewedPatterns(patterns []settings.RulePattern) []settings.RulePattern {
+	result := append([]settings.RulePattern(nil), patterns...)
+	for i := range result {
+		if result[i].Filters != nil {
+			result[i].Filters = append([]settings.PatternFilter(nil), result[i].Filters...)
+		}
+	}
+	return result
+}
+
+func (rule *Rule) EmptyScanMemoEligible() bool {
+	return rule != nil && rule.emptyScanMemoEligible
+}
+
+// The scanner must still prove that no active scan of either closure member
+// can produce an original cycle error before it uses a cached empty result.
+// This method exposes the exact immutable leaf pointer for that guard.
+func (rule *Rule) EmptyScanMemoLeaf() *Rule {
+	if rule == nil || !rule.emptyScanMemoEligible {
+		return nil
+	}
+	return rule.emptyScanMemoLeaf
+}
