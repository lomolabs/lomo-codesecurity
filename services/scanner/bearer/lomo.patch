+			}
+		})
+	}
+}
+
+func TestEmptyScanEligiblePatternsAreImmutableCopies(t *testing.T) {
+	input := shapeFixture("parent", "leaf")
+	rule := shapeRule(t, input, "parent")
+	leaf := rule.EmptyScanMemoLeaf()
+	if leaf == nil {
+		t.Fatal("missing exact closure leaf")
+	}
+	input["parent"].Patterns[0].Pattern = "changed()"
+	input["parent"].Patterns[0].Filters[0].Detection = "changed"
+	input["leaf"].Patterns[0].Pattern = "changed()"
+	returned := rule.Patterns()
+	returned[0].Filters[0].Detection = "changed"
+	returned[0].Pattern = "changed()"
+	leafReturned := leaf.Patterns()
+	leafReturned[0].Pattern = "changed()"
+	if rule.Patterns()[0].Pattern != "app.use($<SESSION_MIDDLEWARE>)" || rule.Patterns()[0].Filters[0].Detection != "leaf" || leaf.Patterns()[0].Pattern != "session()" {
+		t.Fatal("compiled closure aliases mutable input or returned settings")
+	}
+}
+
+func TestEmptyScanEligibilityRejectsTriggerPromotionAndLeafDependencies(t *testing.T) {
+	for _, member := range []string{"parent", "leaf"} {
+		input := shapeFixture("parent", "leaf")
+		input["external"] = &settings.Rule{Id: "external", Type: customdetectors.TypeVerifier, Languages: []string{"javascript"}, Patterns: []settings.RulePattern{{Pattern: "other()"}}, Trigger: settings.RuleTrigger{RequiredDetections: []string{member}}}
+		if shapeRule(t, input, "parent").EmptyScanMemoEligible() {
+			t.Fatalf("trigger-promoted %s authorized", member)
+		}
