+)
+
+func absenceGraph(t *testing.T, count int, cycle bool, sanitized ...bool) (*detectorSet, *ruleset.Set, *tree.Tree) {
+	t.Helper()
+	input := map[string]*settings.Rule{}
+	for i := 0; i < count; i++ {
+		id := fmt.Sprintf("r%d", i)
+		r := &settings.Rule{Id: id, Languages: []string{"javascript"}, Type: customdetectors.TypeVerifier, IsAuxilary: true}
+		if i == count-1 && !cycle {
+			r.Type = customdetectors.TypeShared
+			r.IsAuxilary = false
+			r.Patterns = []settings.RulePattern{{Pattern: "const { $<!>$<MEMBER> } = $<LIBRARY>"}}
+		} else {
+			r.Patterns = []settings.RulePattern{{Pattern: "$<PATH>", Filters: []settings.PatternFilter{{Variable: "PATH", Detection: fmt.Sprintf("r%d", (i+1)%count), Scope: settings.CURSOR_SCOPE}}}}
+		}
+		input[id] = r
+	}
+	if len(sanitized) != 0 && sanitized[0] {
+		input[fmt.Sprintf("r%d", count-1)].SanitizerRuleID = "r0"
+	}
+	lang := javascript.Get()
+	rs, err := ruleset.New("javascript", input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	vs, err := variableshape.NewSet(lang, rs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	qs := query.NewSet(lang.ID(), lang.SitterLanguage())
+	t.Cleanup(qs.Close)
+	ds, err := New(nil, lang, rs, vs, qs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := qs.Compile(); err != nil {
+		t.Fatal(err)
+	}
+	source, err := ast.ParseAndAnalyze(context.Background(), lang, rs, qs, []byte("const value = 1;"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return ds.(*detectorSet), rs, source
+}
+
+func TestQueryAbsenceDepthCycleActiveAndUnknownFences(t *testing.T) {
+	for _, count := range []int{1, 2, 8, 9} {
+		ds, rs, source := absenceGraph(t, count, false)
+		root, _ := rs.RuleByID("r0")
+		if got := PatternsAbsent(ds, root, source); got != (count <= 8) {
+			t.Fatalf("count %d proof=%t", count, got)
+		}
+		if count > 8 {
+			continue
+		}
+		for i := 0; i < count; i++ {
+			rule, _ := rs.RuleByID(fmt.Sprintf("r%d", i))
+			ds.active[rule.Index()].Add(1)
+			if PatternsAbsent(ds, root, source) {
+				t.Fatalf("active reference %d admitted", i)
+			}
+			ds.active[rule.Index()].Add(-1)
+		}
+		if PatternsAbsent(ds, root, nil) || PatternsAbsent(ds, root, &tree.Tree{}) || PatternsAbsent(unsupportedMemoSet{ds}, root, source) {
+			t.Fatal("unknown index/set admitted")
+		}
+	}
+	guarded, guardedRules, guardedSource := absenceGraph(t, 2, false, true)
+	guardedRoot, _ := guardedRules.RuleByID("r0")
+	if PatternsAbsent(guarded, guardedRoot, guardedSource) {
+		t.Fatal("sanitized child admitted")
+	}
+	ds, rs, source := absenceGraph(t, 3, true)
+	root, _ := rs.RuleByID("r0")
+	if PatternsAbsent(ds, root, source) {
+		t.Fatal("cyclic reference proof admitted")
+	}
+}
