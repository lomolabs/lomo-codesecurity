+func TestEmptyScanGuardActualCompiledIdentityAndAllActiveMembers(t *testing.T) {
+	lang := javascript.Get()
+	rs, err := ruleset.New("javascript", map[string]*settings.Rule{
+		"parent": {Id: "parent", Type: customdetectors.TypeVerifier, Languages: []string{"javascript"}, IsAuxilary: true, Patterns: []settings.RulePattern{{Pattern: "app.use($<SESSION_MIDDLEWARE>)", Filters: []settings.PatternFilter{{Variable: "SESSION_MIDDLEWARE", Detection: "leaf", Scope: settings.RESULT_SCOPE}}}}},
+		"leaf":   {Id: "leaf", Type: customdetectors.TypeVerifier, Languages: []string{"javascript"}, IsAuxilary: true, Patterns: []settings.RulePattern{{Pattern: "session()"}}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	vs, err := variableshape.NewSet(lang, rs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	qs := query.NewSet(lang.ID(), lang.SitterLanguage())
+	defer qs.Close()
+	compiled, err := New(nil, lang, rs, vs, qs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parent, err := rs.RuleByID("parent")
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaf := parent.EmptyScanMemoLeaf()
+	if leaf == nil {
+		t.Fatal("missing immutable closure")
+	}
+	if EmptyScanMemoSafety(compiled, parent) == nil {
+		t.Fatal("real compiled closure refused")
+	}
+	if EmptyScanMemoSafety(unsupportedMemoSet{compiled}, parent) != nil || EmptyScanMemoSafety(nil, parent) != nil || EmptyScanMemoSafety(compiled, nil) != nil {
+		t.Fatal("unknown detector set or rule authorized")
+	}
+	actual := compiled.(*detectorSet)
+	for _, member := range []*ruleset.Rule{parent, leaf} {
+		actual.active[member.Index()].Add(1)
+		if EmptyScanMemoSafety(compiled, parent) != nil {
+			t.Fatalf("active member %s authorized", member.ID())
+		}
+		actual.active[member.Index()].Add(-1)
+		if EmptyScanMemoSafety(compiled, parent) == nil {
+			t.Fatal("inactive guard remained blocked")
+		}
+		saved := actual.detectors[member.Index()]
+		actual.detectors[member.Index()] = nil
+		if EmptyScanMemoSafety(compiled, parent) != nil {
+			t.Fatal("missing or unknown compiled member authorized")
+		}
+		actual.detectors[member.Index()] = saved
+	}
+}
