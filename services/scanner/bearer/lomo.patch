+// PatternsAbsent accepts raw-query absence, or an outer conjunction whose
+// first filter references a proven-empty rule through its definitely bound
+// root variable. Later filters are unreachable in that case. Unknown/nested
+// filters and possibly absent variables remain on the original path.
+func (detector *Detector) PatternsAbsent(source *tree.Tree, absent func(*ruleset.Rule) bool) bool {
