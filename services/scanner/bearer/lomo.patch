+// EmptyScanMemoOwner binds completed empty traversals to one compiled set.
+// The nonzero-sized identity must not alias a different set's memo owner.
+type EmptyScanMemoOwner struct{ identity byte }
+
+// EmptyScanMemoSafety fails closed for wrappers and unknown implementations.
+// Only the real set can prove that both immutable closure members are compiled
+// custom detectors and no execution of either member is active anywhere in the
+// AST. The root's ExecutingDetectors alone cannot detect descendant cycles.
+func EmptyScanMemoSafety(candidate Set, rule *ruleset.Rule) *EmptyScanMemoOwner {
+	set, ok := candidate.(*detectorSet)
+	if !ok || set == nil || !rule.EmptyScanMemoEligible() {
+		return nil
+	}
+	leaf := rule.EmptyScanMemoLeaf()
+	for _, member := range []*ruleset.Rule{rule, leaf} {
+		if member == nil || member.Index() < 0 || member.Index() >= len(set.detectors) ||
+			set.active[member.Index()].Load() != 0 {
+			return nil
+		}
+		compiled, ok := set.detectors[member.Index()].(*customrule.Detector)
+		if !ok || compiled.Rule() != member {
+			return nil
+		}
+	}
+	return &set.memoOwner
+}
+
+// PatternsAbsent uses compiled pattern/filter structure, never rule IDs. The
+// proof is bounded to eight acyclic custom references, with no sanitizer or
+// active member that could produce a cycle error. Unknown shapes fall back.
+func PatternsAbsent(candidate Set, rule *ruleset.Rule, source *tree.Tree) bool {
+	s, ok := candidate.(*detectorSet)
+	if !ok || s == nil || source == nil {
+		return false
+	}
+	var path [8]*ruleset.Rule
+	var absent func(*ruleset.Rule, int) bool
+	absent = func(r *ruleset.Rule, depth int) bool {
+		if depth == len(path) || r == nil || (r.Type() != ruleset.RuleTypeShared && r.Type() != ruleset.RuleTypeAuxiliary) || r.SanitizerRule() != nil || r.Index() < 0 || r.Index() >= len(s.detectors) || s.active[r.Index()].Load() != 0 {
+			return false
+		}
+		for _, prior := range path[:depth] {
+			if prior == r {
+				return false
+			}
+		}
+		d, ok := s.detectors[r.Index()].(*customrule.Detector)
+		if !ok || d == nil || d.Rule() != r {
+			return false
+		}
+		path[depth] = r
+		return d.PatternsAbsent(source, func(child *ruleset.Rule) bool { return absent(child, depth+1) })
+	}
+	return absent(rule, 0)
+}
