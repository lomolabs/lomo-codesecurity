+func TestQueryAbsencePreservesReachableVariableErrors(t *testing.T) {
+	for _, emptyFirst := range []bool{false, true} {
+		configure := func(r map[string]*settings.Rule) {
+			empty := settings.PatternFilter{Variable: "PATH", Detection: "leaf", Scope: settings.CURSOR_SCOPE}
+			missing := settings.PatternFilter{Variable: "OTHER", Detection: "leaf", Scope: settings.CURSOR_SCOPE}
+			filters := []settings.PatternFilter{missing, empty}
+			if emptyFirst {
+				filters = []settings.PatternFilter{empty, missing}
+			}
+			r["parent"].Patterns = []settings.RulePattern{
+				{Pattern: "$<PATH>", Filters: filters},
+				// Declares OTHER in the rule shape but does not bind it in the
+				// first pattern. Its own query is absent from the fixture.
+				{Pattern: "other($<OTHER>)"},
+			}
+			r["leaf"].Type = customdetectors.TypeShared
+			r["leaf"].IsAuxilary = false
+			r["leaf"].Patterns = []settings.RulePattern{{Pattern: "const { $<!>$<MEMBER> } = $<LIBRARY>"}}
+		}
+		on := realMemoFixture(t, context.Background(), "const value = 1;", 0, false, configure)
+		off := absenceOffFixture(on)
+		if got := detectorset.PatternsAbsent(on.compiled, on.rule, on.ast); got != emptyFirst {
+			t.Fatalf("emptyFirst=%t proof=%t", emptyFirst, got)
+		}
+		a, ae := scanProjection(t, on, traversalstrategy.Nested)
+		b, be := scanProjection(t, off, traversalstrategy.Nested)
+		if a != b || (ae == nil) != (be == nil) {
+			t.Fatalf("emptyFirst=%t changed error: %s/%v vs %s/%v", emptyFirst, a, ae, b, be)
+		}
+		if emptyFirst {
+			if ae != nil {
+				t.Fatalf("unreachable error: %v", ae)
+			}
+		} else if ae == nil || ae.Error() != be.Error() || ae.Error() != "couldn't find node for var OTHER" {
+			t.Fatalf("reachable error changed: %v/%v", ae, be)
+		}
+	}
+}
