+// A comma-separated subscription is one tuple key. Query captures preserve every
+// repeated field; the AST wrapper's FieldName labels only its first occurrence.
+func subscriptKey(node, objectNode *tree.Node, results []tree.QueryResult) (string, error) {
+	start, end := node.ContentEnd.Byte, node.ContentStart.Byte
+	for _, result := range results {
+		key := result["key"]
+		if objectNode == nil || result["object"] != objectNode || key == nil ||
+			key.Tree() != node.Tree() || key.ContentStart.Byte < node.ContentStart.Byte ||
+			key.ContentEnd.Byte > node.ContentEnd.Byte || key.ContentEnd.Byte < key.ContentStart.Byte {
+			return "", errors.New("invalid subscript projection captures")
+		}
+		if key.ContentStart.Byte < start {
+			start = key.ContentStart.Byte
+		}
+		if key.ContentEnd.Byte > end {
+			end = key.ContentEnd.Byte
+		}
+	}
+	if len(results) == 0 {
+		return "", nil
+	}
+	return string(node.Tree().ContentBytes()[start:end]), nil
+}
