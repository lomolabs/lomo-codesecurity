+// RecordEmptyScanMemoHit is called only after the scanner accepts a live hit.
+func (cache *Cache) RecordEmptyScanMemoHit() {
+	if cache != nil {
+		cache.emptyScanHits.Add(1)
+	}
+}
+
+// PendingEmptyScan records a bounded traversal proof separately from reusable
+// state. Only a complete, empty, live Nested traversal may publish its bits.
+func (cache *Cache) PendingEmptyScan(root *treepkg.Node, rule *ruleset.Rule, owner *detectorset.EmptyScanMemoOwner) []uint64 {
+	if _, _, ok := cache.emptyScanSlot(root, rule); !ok || owner == nil {
+		return nil
+	}
+	return make([]uint64, (cache.tree.NodeCount()+63)/64)
+}
+
+func (cache *Cache) RecordEmptyScanClosure(root *treepkg.Node, rule *ruleset.Rule, owner *detectorset.EmptyScanMemoOwner, visited []uint64) bool {
+	if cache == nil || cache.tree == nil || len(visited) != (cache.tree.NodeCount()+63)/64 ||
+		!cache.RecordEmptyScan(root, rule, owner) {
+		return false
+	}
+	for i, word := range visited {
+		cache.emptyScanBits[i] |= word
+	}
+	return true
+}
