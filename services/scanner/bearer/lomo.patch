+func parseSubscript(t *testing.T, queries *query.Set, expression string) *tree.Node {
+	t.Helper()
+	if err := queries.Compile(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(queries.Close)
+	rules, err := ruleset.New("python", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsed, err := ast.ParseAndAnalyze(context.Background(), python.Get(), rules, queries,
+		[]byte("value = "+expression+"\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	nodes := parsed.Nodes()
+	for index := range nodes {
+		if nodes[index].Type() == "subscript" && nodes[index].Content() == expression {
+			return &nodes[index]
+		}
+	}
+	t.Fatal("exact subscription expression was not parsed")
+	return nil
+}
+
+func TestSubscriptProjectionPreservesWholeKey(t *testing.T) {
+	for _, tc := range []struct{ expression, objectName, key string }{
+		{`table["email"]`, "table", `"email"`},
+		{`table["email", "token"]`, "table", `"email", "token"`},
+		{`table[a, b, c]`, "table", "a, b, c"},
+		{`table["a,b"]`, "table", `"a,b"`},
+		{`table[lookup["email"], "token"]`, "table", `lookup["email"], "token"`},
+		{`matrix[1:5, ::2]`, "matrix", "1:5, ::2"},
+		{`tuple[str, int]`, "tuple", "str, int"},
+		{`Callable[[tuple[str, int], float], socket.socket]`, "Callable", "[tuple[str, int], float], socket.socket"},
+		// Retain the prior one-key spelling; this change does not redesign
+		// canonicalization of tuple keys with a single trailing comma.
+		{`table["email",]`, "table", `"email"`},
+	} {
+		t.Run(tc.expression, func(t *testing.T) {
+			queries := query.NewSet("python", python.Get().SitterLanguage())
+			detector := object.New(queries)
+			node := parseSubscript(t, queries, tc.expression)
+			// A subscript projection is virtual and must not require another
+			// detector scan. The real parser/query/detector are exercised here.
+			values, err := detector.DetectAt(node, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(values) != 1 {
+				t.Fatalf("wanted one complete projection, got %d", len(values))
+			}
+			projected := values[0].(common.Object)
+			if !projected.IsVirtual || len(projected.Properties) != 1 || projected.Properties[0].Name != tc.objectName {
+				t.Fatalf("unexpected projection: %#v", projected)
+			}
+			property := projected.Properties[0].Object
+			if property == nil || property.MatchNode != node {
+				t.Fatal("projection lost its original subscription node")
+			}
+			key := property.Data.(common.Object)
+			if !key.IsVirtual || len(key.Properties) != 1 || key.Properties[0].Name != tc.key {
+				t.Fatalf("tuple key was split, dropped or rewritten: %#v", key)
+			}
+		})
+	}
+}
