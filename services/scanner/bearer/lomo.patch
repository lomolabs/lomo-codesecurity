+
+func sharedPattern(pattern string, extra ...settings.RulePattern) func(map[string]*settings.Rule) {
+	return func(rules map[string]*settings.Rule) {
+		rules["parent"].Type = customdetectors.TypeShared
+		rules["parent"].IsAuxilary = false
+		rules["parent"].Patterns = append([]settings.RulePattern{{Pattern: pattern}}, extra...)
+	}
+}
+
+func TestQueryAbsenceRealCompiledDifferential(t *testing.T) {
+	pattern := "const { $<!>$<MEMBER> } = $<LIBRARY>"
+	for _, tc := range []struct {
+		name, source     string
+		absent, positive bool
+		configure        func(map[string]*settings.Rule)
+	}{
+		{"absent", "function run(value) { return value + 1; }", true, false, sharedPattern(pattern)},
+		{"present", "const { exec } = require('child_process');", false, true, sharedPattern(pattern)},
+		{"nested", "function run() { const { exec } = require('child_process'); }", false, true, sharedPattern(pattern)},
+		{"second-pattern", "foo();", false, true, sharedPattern(pattern, settings.RulePattern{Pattern: "foo()"})},
+		{"root-variable", "const value = 1;", false, true, sharedPattern("$<VALUE>")},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			on := realMemoFixture(t, context.Background(), tc.source, 0, false, tc.configure)
+			off := absenceOffFixture(on)
+			if got := detectorset.PatternsAbsent(on.compiled, on.rule, on.ast); got != tc.absent {
+				t.Fatalf("absence=%t, want %t", got, tc.absent)
+			}
+			if detectorset.PatternsAbsent(memoOff{on.compiled}, on.rule, on.ast) {
+				t.Fatal("unknown set admitted")
+			}
+			for _, scope := range []traversalstrategy.Strategy{traversalstrategy.Nested, traversalstrategy.NestedStrict, traversalstrategy.Cursor, traversalstrategy.CursorStrict, traversalstrategy.Result} {
+				a, ae := scanProjection(t, on, scope)
+				b, be := scanProjection(t, off, scope)
+				if a != b || ae != nil || be != nil {
+					t.Fatalf("%s changed output/error: %s/%v vs %s/%v", scope.Scope(), a, ae, b, be)
+				}
+				if tc.positive && scope == traversalstrategy.Nested && (a == "null" || a == "[]") {
+					t.Fatal("positive control had no detection")
+				}
+			}
+		})
+	}
+}
+
+func TestQueryAbsenceCancellationCycleAndSanitizer(t *testing.T) {
+	pattern := "const { $<!>$<MEMBER> } = $<LIBRARY>"
+	ctx, cancel := context.WithCancel(context.Background())
+	f := realMemoFixture(t, ctx, "const value = 1;", 0, false, sharedPattern(pattern))
+	if !detectorset.PatternsAbsent(f.compiled, f.rule, f.ast) {
+		t.Fatal("fixture not absent")
+	}
+	cancel()
+	if _, err := scanProjection(t, f, traversalstrategy.Nested); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancel: %v", err)
+	}
+	cycle := realMemoFixture(t, context.Background(), "const value = 1;", 0, false, sharedPattern(pattern))
+	cycle.ast.RootNode().ExecutingDetectors = append(cycle.ast.RootNode().ExecutingDetectors, cycle.rule.Index())
+	if _, err := scanProjection(t, cycle, traversalstrategy.Nested); err == nil {
+		t.Fatal("root cycle suppressed")
+	}
+	sanitized := realMemoFixture(t, context.Background(), "const value = 1;", 0, false, func(r map[string]*settings.Rule) { sharedPattern(pattern)(r); r["parent"].SanitizerRuleID = "leaf" })
+	if detectorset.PatternsAbsent(sanitized.compiled, sanitized.rule, sanitized.ast) {
+		t.Fatal("sanitizer admitted")
+	}
+}
+
+func TestQueryAbsenceBoundReferenceDifferential(t *testing.T) {
+	configure := func(r map[string]*settings.Rule) {
+		r["parent"].Patterns = []settings.RulePattern{
+			{Pattern: "$<PATH>", Filters: []settings.PatternFilter{{Variable: "PATH", Detection: "leaf", Scope: settings.CURSOR_SCOPE}}},
+			{Pattern: "import { $<!>exec } from \"child_process\""},
+		}
+		r["leaf"].Type = customdetectors.TypeShared
+		r["leaf"].IsAuxilary = false
+		r["leaf"].Patterns = []settings.RulePattern{{Pattern: "const { $<!>$<MEMBER> } = $<LIBRARY>"}}
+	}
+	for _, tc := range []struct {
+		name, source string
+		absent       bool
+	}{
+		{"negative", "function run(value) { return value + 1; }", true},
+		{"positive", "const { exec } = require('child_process'); exec(input);", false},
+		{"alias", "const { exec } = require('child_process'); const run = exec; run(input);", false},
+		{"second-pattern", "import { exec } from 'child_process';", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			on := realMemoFixture(t, context.Background(), tc.source, 0, false, configure)
+			off := absenceOffFixture(on)
+			if got := detectorset.PatternsAbsent(on.compiled, on.rule, on.ast); got != tc.absent {
+				t.Fatalf("bound proof=%t, want %t", got, tc.absent)
+			}
+			a, ae := scanProjection(t, on, traversalstrategy.Nested)
+			b, be := scanProjection(t, off, traversalstrategy.Nested)
+			if a != b || ae != nil || be != nil {
+				t.Fatalf("ordered result/error changed: %s/%v vs %s/%v", a, ae, b, be)
+			}
+			if !tc.absent && (a == "null" || a == "[]") {
+				t.Fatal("positive reference control produced no finding")
+			}
+		})
+	}
+	// An unbound normal query does not establish that the referenced variable
+	// exists; even a globally empty child must not suppress its original errors.
+	fallback := realMemoFixture(t, context.Background(), "foo(1);", 0, false, func(r map[string]*settings.Rule) {
+		configure(r)
+		r["parent"].Patterns[0].Pattern = "foo($<PATH>)"
+	})
+	if detectorset.PatternsAbsent(fallback.compiled, fallback.rule, fallback.ast) {
+		t.Fatal("normal query's binding assumed")
+	}
+}
+
+// Independent compilation can assign variables to different shape slots. Use
+// the same immutable AST/compiled rules, but distinct scanner/cache instances,
+// so complete ordered detection data is compared without masking that layout.
+func absenceOffFixture(on realFixture) realFixture {
+	off := on
+	off.memo = cache.NewCache(on.ast, cache.NewShared(on.rules.Rules()))
+	off.scanner = rulescanner.New(context.Background(), memoOff{on.compiled}, "memo.js", nil, traversalstrategy.NewCache(on.ast.NodeCount()), off.memo)
+	return off
+}
