+// emptyScanSlot applies only to the reviewed immutable two-rule pattern
+// closure with no sanitizer. IDs never grant eligibility. General auxiliary
+// rules may have context-dependent recursion and cannot use this memo.
+// The bitset is at most 31,256 bytes; larger trees keep the original path.
+func (cache *Cache) emptyScanSlot(root *treepkg.Node, rule *ruleset.Rule) (int, uint64, bool) {
+	if cache == nil || !cache.enabled || cache.tree == nil || root == nil || rule == nil ||
+		cache.tree.NodeCount() > maxEmptyScanMemoNodes || root.Tree() != cache.tree ||
+		rule.Type() != ruleset.RuleTypeAuxiliary || rule.SanitizerRule() != nil ||
+		!rule.EmptyScanMemoEligible() || root.ID < 0 || root.ID >= cache.tree.NodeCount() {
+		return 0, 0, false
+	}
+	return root.ID / 64, uint64(1) << uint(root.ID%64), true
+}
+
+// EmptyScanCached says a previous complete empty Nested traversal covered
+// this exact node/rule and its reachable closure. The scanner checks scope, context
+// cancellation and active recursion before using the result.
+func (cache *Cache) EmptyScanCached(root *treepkg.Node, rule *ruleset.Rule, owner *detectorset.EmptyScanMemoOwner) bool {
+	word, mask, ok := cache.emptyScanSlot(root, rule)
+	hit := ok && owner != nil && cache.emptyScanOwner == owner && cache.emptyScanRule == rule &&
+		word < len(cache.emptyScanBits) && cache.emptyScanBits[word]&mask != 0
+	return hit
+}
+
+func (cache *Cache) RecordEmptyScan(root *treepkg.Node, rule *ruleset.Rule, owner *detectorset.EmptyScanMemoOwner) bool {
+	word, mask, ok := cache.emptyScanSlot(root, rule)
+	if !ok || owner == nil {
+		return false
+	}
+	if cache.emptyScanRule != nil && (cache.emptyScanRule != rule || cache.emptyScanOwner != owner) {
+		return false
+	}
+	if cache.emptyScanBits == nil {
+		cache.emptyScanBits = make([]uint64, (cache.tree.NodeCount()+63)/64)
+	}
+	cache.emptyScanRule = rule
+	cache.emptyScanOwner = owner
+	cache.emptyScanBits[word] |= mask
+	cache.emptyScanRecords.Add(1)
+	return true
+}
+
+// EmptyScanMemoCounts exposes bounded, atomic in-process test counters only.
+// They have no runtime configuration, logs, file sink or external protocol.
+// Counts survive Clear, while all reusable bits and their owner are cleared.
+func (cache *Cache) EmptyScanMemoCounts() (hits, records uint64) {
+	if cache == nil {
+		return 0, 0
+	}
+	return cache.emptyScanHits.Load(), cache.emptyScanRecords.Load()
+}
