+	later := &countedFilter{result: filters.NewResult()}
+	conjunction := &filters.PatternAll{All: &filters.All{Children: []filters.Filter{first, dead, later}}}
+	if result, err := conjunction.Evaluate(nil, nil); result != nil || !errors.Is(err, canceled) || first.calls != 1 || dead.calls != 0 || later.calls != 0 {
