+package rulescanner
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/rs/zerolog"
+	"github.com/rs/zerolog/log"
+	sitter "github.com/smacker/go-tree-sitter"
+	"github.com/smacker/go-tree-sitter/javascript"
+
+	"github.com/bearer/bearer/pkg/scanner/ast/traversalstrategy"
+	"github.com/bearer/bearer/pkg/scanner/ast/tree"
+	"github.com/bearer/bearer/pkg/scanner/cache"
+	detectortypes "github.com/bearer/bearer/pkg/scanner/detectors/types"
+	"github.com/bearer/bearer/pkg/scanner/detectorset"
+	"github.com/bearer/bearer/pkg/scanner/ruleset"
+)
+
+type traceGateDetectorSet struct {
+	calls  int
+	result *detectorset.Result
+}
+
+func (set *traceGateDetectorSet) DetectAt(*tree.Node, *ruleset.Rule, detectortypes.Context) (*detectorset.Result, error) {
+	set.calls++
+	return set.result, nil
+}
+
+func TestTraceGatePreservesDetectionAndOutputAcrossLevels(t *testing.T) {
+	priorLogger, priorLevel := log.Logger, zerolog.GlobalLevel()
+	defer func() {
+		log.Logger = priorLogger
+		zerolog.SetGlobalLevel(priorLevel)
+	}()
+
+	content := []byte("const value = 1")
+	parsed, err := sitter.ParseCtx(context.Background(), content, javascript.GetLanguage())
+	if err != nil {
+		t.Fatal(err)
+	}
+	ast := tree.NewBuilder(javascript.GetLanguage(), content, parsed, 5, nil).Build()
+	node := ast.RootNode()
+	rule := ruleset.BuiltinDatatypeRule
+	// Enumerate independently of traversalstrategy.Nested, including aliases.
+	// A nil detector result must not prune any of these reachable nodes.
+	reachable := map[*tree.Node]bool{}
+	stack := []*tree.Node{node}
+	for len(stack) > 0 {
+		current := stack[len(stack)-1]
+		stack = stack[:len(stack)-1]
+		if reachable[current] {
+			continue
+		}
+		reachable[current] = true
+		stack = append(stack, current.Children()...)
+		stack = append(stack, current.AliasOf()...)
+	}
+	if len(reachable) < 2 {
+		t.Fatal("fixture must contain multiple reachable AST nodes")
+	}
+	for _, level := range []struct {
+		name  string
+		value zerolog.Level
+		trace bool
+	}{
+		{"info", zerolog.InfoLevel, false},
+		{"debug", zerolog.DebugLevel, false},
+		{"trace", zerolog.TraceLevel, true},
+	} {
+		t.Run(level.name, func(t *testing.T) {
+			var output bytes.Buffer
+			log.Logger = zerolog.New(&output).Level(zerolog.TraceLevel)
+			zerolog.SetGlobalLevel(level.value)
+			result := &detectorset.Result{Sanitized: true}
+			set := &traceGateDetectorSet{result: result}
+			scanner := New(context.Background(), set, "fixture.js", nil,
+				traversalstrategy.NewCache(ast.NodeCount()), cache.NewCache(ast, cache.NewShared([]*ruleset.Rule{rule})))
+			for i := 0; i < 2; i++ {
+				got, err := scanner.detectAtNode(rule, node)
+				if err != nil || got != result {
+					t.Fatalf("detection result changed on visit %d: %v, %v", i, got, err)
+				}
+			}
+			if set.calls != 1 {
+				t.Fatalf("cached detection invoked detector %d times", set.calls)
+			}
+			// A disabled rule already stores a nil result in the cache. Its
+			// trace-on cache hit must remain a miss without dereferencing nil.
+			cached := cache.NewCache(ast, cache.NewShared([]*ruleset.Rule{rule}))
+			cached.Put(node, rule, nil)
+			cachedScanner := New(context.Background(), set, "fixture.js", nil,
+				traversalstrategy.NewCache(ast.NodeCount()), cached)
+			if got, err := cachedScanner.detectAtNode(rule, node); err != nil || got != nil {
+				t.Fatalf("cached nil result changed: %v, %v", got, err)
+			}
+			if set.calls != 1 {
+				t.Fatalf("cached nil invoked detector %d times", set.calls)
+			}
+			// A fresh detector miss now returns nil and is cached as a distinct
+			// hit; both visits must remain non-detections without re-invocation.
+			emptySet := &traceGateDetectorSet{}
+			emptyScanner := New(context.Background(), emptySet, "fixture.js", nil,
+				traversalstrategy.NewCache(ast.NodeCount()),
+				cache.NewCache(ast, cache.NewShared([]*ruleset.Rule{rule})))
+			for i := 0; i < 2; i++ {
+				if got, err := emptyScanner.detectAtNode(rule, node); err != nil || got != nil {
+					t.Fatalf("empty detection changed on visit %d: %v, %v", i, got, err)
+				}
+			}
+			if emptySet.calls != 1 {
+				t.Fatalf("empty result cache invoked detector %d times", emptySet.calls)
+			}
+			scanSet := &traceGateDetectorSet{}
+			scan := New(context.Background(), scanSet, "fixture.js", nil,
+				traversalstrategy.NewCache(ast.NodeCount()),
+				cache.NewCache(ast, cache.NewShared([]*ruleset.Rule{rule})))
+			detections, err := scan.Scan(node, rule, traversalstrategy.Nested)
+			if err != nil || len(detections) != 0 || scanSet.calls != len(reachable) {
+				t.Fatalf("empty scan changed: detections=%d err=%v calls=%d reachable=%d", len(detections), err, scanSet.calls, len(reachable))
+			}
+			// The disabled rule skips the detector and caches nil as well.
+			disabledBuilder := tree.NewBuilder(javascript.GetLanguage(), content, parsed, 5, nil)
+			disabledBuilder.AddDisabledRules(parsed, []*ruleset.Rule{rule})
+			disabledTree := disabledBuilder.Build()
+			disabledScanner := New(context.Background(), set, "fixture.js", nil,
+				traversalstrategy.NewCache(disabledTree.NodeCount()),
+				cache.NewCache(disabledTree, cache.NewShared([]*ruleset.Rule{rule})))
+			for i := 0; i < 2; i++ {
+				if got, err := disabledScanner.detectAtNode(rule, disabledTree.RootNode()); err != nil || got != nil {
+					t.Fatalf("disabled detection changed on visit %d: %v, %v", i, got, err)
+				}
+			}
+			if set.calls != 1 {
+				t.Fatalf("disabled rule invoked detector %d times", set.calls)
+			}
+			text := output.String()
+			if has := strings.Contains(text, "detect at node start:"); has != level.trace {
+				t.Fatalf("trace start presence = %t, want %t", has, level.trace)
+			}
+			if has := strings.Contains(text, "(cached)"); has != level.trace {
+				t.Fatalf("trace cached result presence = %t, want %t", has, level.trace)
+			}
+			if has := strings.Contains(text, "0 detections (cached)"); has != level.trace {
+				t.Fatalf("trace nil result presence = %t, want %t", has, level.trace)
+			}
+		})
+	}
+}
+
+func TestCancellationAtTraversalBoundaryBeforeDetector(t *testing.T) {
+	content := []byte("const value = 1")
+	parsed, err := sitter.ParseCtx(context.Background(), content, javascript.GetLanguage())
+	if err != nil {
+		t.Fatal(err)
+	}
+	ast := tree.NewBuilder(javascript.GetLanguage(), content, parsed, 5, nil).Build()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	set := &traceGateDetectorSet{}
+	rule := ruleset.BuiltinDatatypeRule
+	scanner := New(ctx, set, "fixture.js", nil,
+		traversalstrategy.NewCache(ast.NodeCount()),
+		cache.NewCache(ast, cache.NewShared([]*ruleset.Rule{rule})))
+	detections, err := scanner.Scan(ast.RootNode(), rule, traversalstrategy.Nested)
+	if detections != nil || !errors.Is(err, context.Canceled) || set.calls != 0 {
+		t.Fatalf("traversal cancellation changed: detections=%v error=%v calls=%d", detections, err, set.calls)
+	}
+}
